# Copy to .env and edit. DO NOT COMMIT .env or secrets.
WB_TOP_N=200
WB_DESTINATION=1259570991
WB_REQUEST_DELAY_SECONDS=5
WB_REQUEST_RETRIES=3
WB_PAGE_LIMIT=15
WB_RUN_ON_STARTUP=true
# Internal endpoint is undocumented; must be verified against live WB.
WB_SEARCH_URL=https://u-search.wb.ru/exactmatch/ru/common/v18/search
WB_HTTP_TRANSPORT=httpx
# Optional autonomous Chromium in Docker (requires same-origin internal search URL).
# WB_HTTP_TRANSPORT=browser
WB_BROWSER_TIMEOUT_SECONDS=90
WB_BROWSER_ENGINE=playwright
WB_SESSION_FILE=
WB_QUERY_DELAY_SECONDS=5
WB_RETRY_BASE_SECONDS=5
WB_RETRY_MAX_SECONDS=60
WB_RETRY_JITTER_SECONDS=1

# Public access: add --profile public to the browser Compose command:
# Domain A-record must point to this VPS. Caddy manages TLS.
# APP_DOMAIN=serp.example.com
# Caddy bcrypt hash: single quotes prevent $ interpolation.
# BASIC_AUTH_HASH='$2a$14$...'
