        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Свежих / 70",
      "type": "stat",
      "description": "Фразы с полным или неполным снимком за последние два часа.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(time() - wb_query_last_valid_timestamp_seconds < 7200) or vector(0)",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
