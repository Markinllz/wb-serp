      "targets": [
        {
          "refId": "A",
          "expr": "clamp_max(count(container_last_seen{container_label_com_docker_compose_service=\"collector\",container_label_com_docker_compose_oneoff!=\"True\"} > time() - 90), 1) or vector(0)",
